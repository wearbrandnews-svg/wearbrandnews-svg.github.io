{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-knowledge-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // global_fetch_strictly_public：Client ID Metadata Document（Claude・Codexのクライアント情報）の取得に必要
  "compatibility_flags": ["global_fetch_strictly_public"],
  // 起動時の読み込み量を減らしてCPU時間（無料枠は1リクエスト10ms）を節約する
  "minify": true,
  // 実行ログ（Cloudflareダッシュボードの Workers → ai-knowledge-mcp → ログ）。無料枠内
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "KNOWLEDGE_WRITES", "class_name": "KnowledgeCoordinator" }]
  },
  "migrations": [{ "tag": "knowledge-coordinator-v1", "new_sqlite_classes": ["KnowledgeCoordinator"] }],
  "kv_namespaces": [
    // `npx wrangler kv namespace create OAUTH_KV` で表示された id に置き換える
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ]
  // 秘密情報は `npx wrangler secret put <名前>` で登録する（README参照）：
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, ALLOWED_EMAIL, KNOWLEDGE_FOLDER_ID, BACKUP_FOLDER_ID
}
